# Docker Compose reads this file as data, not shell commands.
# Copy to .env; start.sh creates it automatically when absent.
COMPOSE_FILE=docker-compose-https.yml

# Fork repository plus #branch, #tag, or #full-commit-SHA.
CTFD_SOURCE_URL='https://github.com/raistlinJ/CTFd.git#feature/retract-solves'
CTFD_IMAGE=ctfd-https-source:local
CTFD_WORKERS=4

HTTP_PORT=80
HTTPS_PORT=443
NGINX_IMAGE=nginx:1.30.5
MARIADB_IMAGE=mariadb:10.11
REDIS_IMAGE=redis:7-alpine

# Keep the existing credentials when reusing an initialized ./db directory.
# For a new database, set matching MYSQL_* credentials and CTFD_DATABASE_URL.
# URL-encode special characters in the database URL's username/password.
MYSQL_DATABASE=ctfd
MYSQL_USER=ctfd
MYSQL_PASSWORD=ctfd
MYSQL_ROOT_PASSWORD=root
CTFD_DATABASE_URL='mysql+pymysql://ctfd:ctfd@db/ctfd'

# The existing CTFd SECRET_KEY stays in secrets/.env and is reused by start.sh.
